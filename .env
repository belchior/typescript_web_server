# This file is development only
# ######################################

# Server
# ######################################
POSTGRES_CONNECTIONS_NUMBER=4
POSTGRES_DB=database
POSTGRES_HOST=database
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_TIMEOUT=300000
POSTGRES_USER=postgres

CLIENT_URL=http://localhost:5173
LOG_LEVEL=info
NODE_ENV=development
SERVER_HOST=localhost
SERVER_NAME=graphql_server
SERVER_PORT=4000

# client
# ######################################

# used by vite to build the app
VITE_SERVER_URL='http://localhost:4000'

# used by docker to build the image
CLIENT_PORT=5173
SERVER_PROXY_PASS=location /graphql { proxy_pass http://<server_name.com:4000>/graphql; }
{
  "name": "typescript_web_server",
  "description": "server",
  "version": "1.0.0",
  "author": "Belchior Oliveira",
  "license": "MIT",
  "engines": {
    "node": ">=24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belchior/typescript_web_server.git"
  },
  "scripts": {
    "build:prd": "tsc --project tsconfig.prod.json",
    "build": "tsc --project tsconfig.json",
    "dev": "node --watch-path=src -r ts-node/register src/infrastructure/graphql_server/server.ts",
    "lint": "tsc --noEmit && eslint 'src/**/*.ts'",
    "test:ci": "NODE_ENV=test jest --ci --coverage=true src/ tests/",
    "test:dev": "NODE_ENV=test jest --watch --coverage=false src/ tests/",
    "test:integration": "NODE_ENV=test jest --watch tests/",
    "test:unit": "NODE_ENV=test jest --watch --coverage=false src/",
    "write-schema": "ts-node scripts/write_graphql_schema.ts"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "express": "^5.2.1",
    "graphql": "^16.13.1",
    "graphql-http": "^1.22.4",
    "pg": "^8.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^10.0.3",
    "eslint-plugin-jest": "^29.15.0",
    "globals": "^17.4.0",
    "jest": "^30.2.0",
    "jiti": "^2.6.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  }
}